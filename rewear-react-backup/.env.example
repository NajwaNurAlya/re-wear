# Data source: "mock" (localStorage + seed data) or "supabase" (real backend)
VITE_DATA_SOURCE=mock

# Needed when VITE_DATA_SOURCE=supabase. Use the ANON / publishable key ONLY.
# NEVER put the service_role key in any VITE_ variable: it would ship to every visitor's browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
